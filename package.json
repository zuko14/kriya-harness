{
  "name": "@kriya-ai/harness",
  "version": "0.2.5",
  "description": "Kriya Harness (beta): a Kriya agent on your machine, built on DeepSeek Harness",
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.9"
  },
  "bin": {
    "kriya": "bin/kriya.js"
  },
  "files": [
    "bin/",
    "src/",
    "bundle/",
    "plugins/",
    "contract/",
    "studio/dist/",
    "SAFETY.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:media": "node --test --test-concurrency=1 --test-timeout=280000 \"tests/edit/media/*.test.js\"",
    "bench:m": "node tests/edit/bench-m/run.js",
    "build:studio": "node studio/build.js",
    "check:pins": "node scripts/check-pins.js",
    "check:seams": "node scripts/check-seams.js",
    "check:notices": "node scripts/notices.js --check",
    "notices": "node scripts/notices.js",
    "dump-config": "node scripts/dump-config.js",
    "check": "npm run check:pins && npm run check:seams && npm run check:notices && npm run check:brand && npm test",
    "release:check": "npm run check:pins && npm run check:seams && node scripts/notices.js --check --strict",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev --package-lock-only",
    "build:brand": "node scripts/build-brand.js",
    "check:brand": "node scripts/build-brand.js --check"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "ajv": "8.17.1",
    "esbuild": "0.28.2"
  }
}
