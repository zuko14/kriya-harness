{
  "basePath": "/api/harness/v1",
  "headers": {
    "version": "X-Kriya-Harness",
    "auth": "Authorization: Bearer <device token>"
  },
  "error": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "error": {
        "type": "string",
        "enum": [
          "not_found",
          "bad_request",
          "upgrade",
          "unauthorized",
          "suspended",
          "rate_limited",
          "pending",
          "denied",
          "expired",
          "server_error",
          "harness_off",
          "plan_not_allowed",
          "tier_not_allowed",
          "cap_reached",
          "not_priced",
          "upstream_unavailable"
        ]
      },
      "message": {
        "type": "string"
      },
      "minVersion": {
        "type": "string"
      },
      "retryAfter": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "required": ["error", "message"],
    "additionalProperties": false
  },
  "routes": [
    {
      "method": "POST",
      "path": "/device/code",
      "auth": false,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "platform": {
            "type": "string",
            "enum": ["darwin", "linux", "win32"]
          },
          "clientVersion": {
            "type": "string",
            "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
          }
        },
        "required": ["deviceName", "platform", "clientVersion"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceCode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "userCode": {
            "type": "string",
            "pattern": "^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$"
          },
          "verificationUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresIn": {
            "type": "number",
            "const": 600
          },
          "interval": {
            "type": "number",
            "const": 5
          }
        },
        "required": [
          "deviceCode",
          "userCode",
          "verificationUrl",
          "expiresIn",
          "interval"
        ],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/device/token",
      "auth": false,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceCode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": ["deviceCode"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["token", "deviceId"],
        "additionalProperties": false
      }
    },
    {
      "method": "GET",
      "path": "/me",
      "auth": true,
      "request": null,
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "displayName": {
            "type": ["string", "null"]
          },
          "plan": {
            "type": "string"
          },
          "harness": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "capMicroInr": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "usedMicroInr": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unpriced": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["enabled", "capMicroInr", "usedMicroInr", "unpriced"],
            "additionalProperties": false
          },
          "agent": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["id", "name"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "minClientVersion": {
            "type": "string",
            "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
          }
        },
        "required": ["displayName", "plan", "harness", "agent", "minClientVersion"],
        "additionalProperties": false
      }
    },
    {
      "method": "DELETE",
      "path": "/device",
      "auth": true,
      "request": null,
      "response": null
    },
    {
      "method": "GET",
      "path": "/models",
      "auth": true,
      "request": null,
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": ["budget", "balanced", "escalation"]
                },
                "object": {
                  "type": "string",
                  "const": "model"
                },
                "owned_by": {
                  "type": "string",
                  "const": "kriya"
                }
              },
              "required": ["id", "object", "owned_by"],
              "additionalProperties": false
            }
          }
        },
        "required": ["object", "data"],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/chat/completions",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "messages": {
            "minItems": 1,
            "maxItems": 2000,
            "type": "array",
            "items": {}
          },
          "stream": {
            "type": "boolean"
          },
          "max_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "max_completion_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["model", "messages"],
        "additionalProperties": {}
      },
      "response": null
    }
  ]
}
